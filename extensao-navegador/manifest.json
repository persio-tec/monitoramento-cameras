{
  "manifest_version": 3,
  "name": "Câmeras locais (monitoramento)",
  "version": "1.0.0",
  "description": "Mostra as câmeras do Monitoramento por Câmeras direto no navegador, pela rede local ou pela VPN Tailscale.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Câmeras locais"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
